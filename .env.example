PORT=3000
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/tasktracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# AI task descriptions: "gemini" (needs GEMINI_API_KEY) or "mock" (no key needed).
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional
# UPLOAD_DIR=uploads
# MAX_UPLOAD_BYTES=5242880
